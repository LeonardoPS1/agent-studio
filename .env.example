# OpenFang Studio - Variables de entorno
# Copiar a .env.local (desarrollo) o configurar en Dokploy > Environment

# === OpenFang (motor) ===
OPENFANG_API_KEY=change-me-generate-a-long-random-string
OPENFANG_VERSION=v0.6.9
OPENFANG_SHA256=4309b0bcf2adc5dac45776e2008087a8ad072933f1ae698ff8d4e06fb6b87602

# Proveedores de IA (opcionales según config.toml)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Integraciones (opcionales)
TELEGRAM_BOT_TOKEN=

# === Studio (Next.js) ===
STUDIO_PASSWORD=change-me-strong-password
STUDIO_SECRET=change-me-min-32-random-characters
OPENFANG_URL=http://openfang:4200
