# --- Obligatorias ---
# Clave que Studio usa para hablar con OpenFang (genérala: openssl rand -hex 32)
OPENFANG_API_KEY=
# Contraseña para entrar a Studio
STUDIO_PASSWORD=
# Secreto para firmar la cookie de sesión (openssl rand -hex 32)
STUDIO_SECRET=

# --- Proveedores de modelos (al menos uno) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Opcionales ---
TELEGRAM_BOT_TOKEN=
# Versión de OpenFang y su checksum SHA-256 (cámbialos juntos al actualizar)
OPENFANG_VERSION=v0.6.9
OPENFANG_SHA256=4309b0bcf2adc5dac45776e2008087a8ad072933f1ae698ff8d4e06fb6b87602
