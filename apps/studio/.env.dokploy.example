# --- Agent Studio (OpenFang Studio) ---
# Copy to .env.dokploy and fill in real values. Never commit the real file.

# Studio Postgres database (SEPARATE from any clinical database).
# Studio owns its own runs/events/views tables; it must not write into
# other applications' schemas.
DATABASE_URL=postgresql://studio_app:CHANGE_ME@172.18.0.1:5432/studio

# Dashboard session auth (both required; without them /api/login returns 503).
STUDIO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
STUDIO_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# OpenFang engine (server-side only; never exposed to the browser).
OPENFANG_BASE_URL=http://openfang:8080
OPENFANG_API_KEY=CHANGE_ME

# Event retention: days of `events` rows to keep. 0 disables pruning.
EVENTS_RETENTION_DAYS=30
